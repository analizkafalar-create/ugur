<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Mevcut dosya veya klasör ise doğrudan sun
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # SPA yönlendirmesi: Tüm diğer istekleri index.html'e yönlendir (Shopier dönüşleri ve davet linkleri için)
  RewriteRule ^ index.html [L]
</IfModule>

# Doğru MIME Türleri
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType application/json .json
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
  AddType application/wasm .wasm
</IfModule>

# GZIP Sıkıştırma (Hızlı Yükleme)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

# Tarayıcı Önbellekleme (Statik Varlıklar İçin)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
</IfModule>
